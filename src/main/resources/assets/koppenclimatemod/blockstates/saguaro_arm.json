{
  "multipart": [
    {
      "apply": {
        "model": "koppenclimatemod:block/saguaro_core"
      }
    },
    {
      "when": {
        "facing": "north"
      },
      "apply": {
        "model": "koppenclimatemod:block/saguaro_elbow"
      }
    },
    {
      "when": {
        "facing": "east"
      },
      "apply": {
        "model": "koppenclimatemod:block/saguaro_elbow",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south"
      },
      "apply": {
        "model": "koppenclimatemod:block/saguaro_elbow",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west"
      },
      "apply": {
        "model": "koppenclimatemod:block/saguaro_elbow",
        "y": 270
      }
    },
    {
      "when": {
        "up": "true"
      },
      "apply": {
        "model": "koppenclimatemod:block/saguaro_up"
      }
    }
  ]
}